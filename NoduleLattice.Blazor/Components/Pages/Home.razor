@page "/"
@implements IAsyncDisposable
@using NoduleLattice.Blazor.Models
@using NoduleLattice.Blazor.Services
@using NoduleLattice.Blazor.Components.Network
@inject LatticeApiClient Api

<div class="page">
    <header class="topbar">
        <div class="title">
            <div class="h1">NoduleLattice</div>
            <div class="sub">Real-time runner • snapshot polling • cortex-look renderer</div>
        </div>

        <div class="status">
            <div class="pill">step @_stepIndex</div>
            <div class="pill">@(_runStatus?.Running == true ? "RUNNING" : "STOPPED")</div>
        </div>
    </header>

    <section class="card">
        <header class="card-h">
            <div>
                <div class="h-title">Snapshot Mode</div>
                <div class="h-sub">Thin mode keeps UI real-time as synapses scale up</div>
            </div>
            <div class="pill mono">@(_thinSnapshots ? "THIN" : "FULL")</div>
        </header>

        <div class="form">
            <label class="lbl">Thin snapshots</label>
            <div class="row">
                <input type="checkbox" @bind="_thinSnapshots" />
                <span class="muted">Use /snapshot?mode=thin</span>
            </div>

            <label class="lbl">Max edges</label>
            <input class="input" type="number" min="100" max="250000" @bind="_thinMaxEdges" />

            <label class="lbl">Max edge len</label>
            <input class="input" type="number" step="0.5" min="0.5" max="200" @bind="_thinMaxLen" />

            <label class="lbl">Poll ms (UI)</label>
            <input class="input" type="number" min="16" max="2000" @bind="_pollMs" />

            <label class="lbl">Auto-poll</label>
            <div class="row">
                <input type="checkbox" @bind="_autoPoll" />
                <span class="muted">Update snapshot on timer</span>
            </div>
        </div>

        <div class="row actions">
            <button class="btn" @onclick="ApplySnapshotMode">Apply</button>
            <button class="btn" @onclick="Refresh">Refresh Now</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_apiError))
        {
            <div class="err small" style="margin-top:0.5rem;">@_apiError</div>
        }
    </section>

    <section class="grid">
        <section class="card">
            <header class="card-h">
                <div>
                    <div class="h-title">Run (Real-Time)</div>
                    <div class="h-sub">Background stepping loop hosted by the API</div>
                </div>
                <div class="pill mono">@(_runStatus?.Running == true ? "RUNNING" : "STOPPED")</div>
            </header>

            <div class="form">
                <label class="lbl">Target Hz</label>
                <input class="input" type="number" min="1" max="240" @bind="_runHz" />

                <label class="lbl">Steps / Tick</label>
                <input class="input" type="number" min="1" max="4096" @bind="_runStepsPerTick" />
            </div>

            <div class="row actions">
                <button class="btn" @onclick="StartRunner">Start</button>
                <button class="btn" @onclick="StopRunner">Stop</button>
            </div>

            @if (_runStatus is not null)
            {
                <div class="mono small" style="margin-top:0.75rem;">
                    ticks=@_runStatus.Ticks • hz=@_runStatus.TargetHz • steps/tick=@_runStatus.StepsPerTick
                    @if (!string.IsNullOrWhiteSpace(_runStatus.LastError))
                    {
                        <div class="err small">runner error: @_runStatus.LastError</div>
                    }
                </div>
            }
        </section>

        <section class="card">
            <header class="card-h">
                <div>
                    <div class="h-title">Manual</div>
                    <div class="h-sub">One-shot stepping (works even if runner is stopped)</div>
                </div>
                <div class="pill mono">step @_stepIndex</div>
            </header>

            <div class="row actions" style="flex-wrap:wrap;">
                <button class="btn" @onclick="() => Step(1)">Step 1</button>
                <button class="btn" @onclick="() => Step(8)">Step 8</button>
                <button class="btn" @onclick="() => Step(16)">Step 16</button>
                <button class="btn" @onclick="() => Step(64)">Step 64</button>
                <button class="btn" @onclick="() => Step(128)">Step 128</button>
            </div>

            <div class="row" style="margin-top:0.75rem;">
                <button class="btn" @onclick="SleepReplay">Sleep (gated)</button>
                <div class="spacer"></div>
                <div class="mono small">@Api.LastResolvedSnapshotPath</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Api.LastError))
            {
                <div class="err small" style="margin-top:0.5rem;">@Api.LastError</div>
            }
        </section>
    </section>

    <section class="card">
        <header class="card-h">
            <div>
                <div class="h-title">3D Network</div>
                <div class="h-sub">Cortex slab • lamina planes • edge thinning • hover column highlight</div>
            </div>
            <div class="pill mono">step @_stepIndex</div>
        </header>

        <Network3D Snapshot="_snapshot" View="_view" HeightPx="520" />

        <details style="margin-top:0.75rem;">
            <summary class="mono" style="cursor:pointer;">Visual controls</summary>

            <div class="form" style="margin-top:0.75rem;">
                <label class="lbl">Spacing XY</label>
                <input class="input" type="number" step="0.05" @bind="_view.SpacingXY" />

                <label class="lbl">Z Scale</label>
                <input class="input" type="number" step="0.05" @bind="_view.ZScale" />

                <label class="lbl">Node Size</label>
                <input class="input" type="number" step="0.01" @bind="_view.NodeSize" />

                <label class="lbl">Node Opacity</label>
                <input class="input" type="number" step="0.05" @bind="_view.NodeOpacity" />

                <label class="lbl">Edge Soft Fade Len</label>
                <input class="input" type="number" step="0.1" @bind="_view.EdgeSoftFadeLen" />

                <label class="lbl">Edge Hard Cull Len</label>
                <input class="input" type="number" step="0.1" @bind="_view.EdgeHardCullLen" />

                <label class="lbl">Edge Opacity</label>
                <input class="input" type="number" step="0.05" @bind="_view.EdgeOpacity" />

                <label class="lbl">Fog Density</label>
                <input class="input" type="number" step="0.001" @bind="_view.FogDensity" />

                <div class="row" style="margin-top:0.5rem; flex-wrap:wrap;">
                    <label class="chk">
                        <input type="checkbox" @bind="_view.ShowLaminarPlanes" />
                        <span>Laminar planes</span>
                    </label>

                    <label class="chk">
                        <input type="checkbox" @bind="_view.ShowGrid" />
                        <span>Grid</span>
                    </label>

                    <label class="chk">
                        <input type="checkbox" @bind="_view.ShowAxes" />
                        <span>Axes</span>
                    </label>

                    <label class="chk">
                        <input type="checkbox" @bind="_view.EnableFog" />
                        <span>Fog</span>
                    </label>
                </div>
            </div>
        </details>
    </section>
</div>

@code {
    private long _stepIndex;
    private LatticeSnapshotDto? _snapshot;

    private string _apiError = "";

    private RunStatusDto? _runStatus;

    private int _runHz = 30;
    private int _runStepsPerTick = 2;

    private bool _autoPoll = true;
    private int _pollMs = 66; // ~15Hz UI refresh

    private CancellationTokenSource? _pollCts;
    private Task? _pollTask;

    private NetworkViewOptions _view = new();

    // Thin snapshot UI
    private bool _thinSnapshots = true;
    private int _thinMaxEdges = 12_000;
    private float _thinMaxLen = 7f;

    protected override async Task OnInitializedAsync()
    {
        ApplySnapshotMode();
        await Refresh();

        if (_autoPoll)
            StartPolling();
    }

    private void ApplySnapshotMode()
    {
        Api.UseThinSnapshot = _thinSnapshots;
        Api.ThinMaxEdges = _thinMaxEdges;
        Api.ThinMaxLen = _thinMaxLen;
    }

    private async Task Refresh()
    {
        _apiError = string.Empty;

        _snapshot = await Api.GetSnapshot();
        _runStatus = await Api.RunStatus();

        if (_snapshot is null)
        {
            _apiError = Api.LastError ?? "Unknown error.";
            _stepIndex = 0;
            StateHasChanged();
            return;
        }

        _stepIndex = _snapshot.StepIndex;

        if (!string.IsNullOrWhiteSpace(Api.LastError))
            _apiError = Api.LastError!;

        StateHasChanged();
    }

    private async Task Step(int n)
    {
        await Api.Step(n);
        await Refresh();
    }

    private async Task SleepReplay()
    {
        await Api.SleepReplay();
        await Refresh();
    }

    private async Task StartRunner()
    {
        _runStatus = await Api.RunStart(new RunRequestModel
        {
            TargetHz = _runHz,
            StepsPerTick = _runStepsPerTick
        });

        if (_autoPoll)
            StartPolling();

        await Refresh();
    }

    private async Task StopRunner()
    {
        _runStatus = await Api.RunStop();
        await Refresh();
    }

    private void StartPolling()
    {
        if (_pollTask is not null && !_pollTask.IsCompleted)
            return;

        _pollCts?.Cancel();
        _pollCts?.Dispose();

        _pollCts = new CancellationTokenSource();
        var ct = _pollCts.Token;

        _pollTask = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(Math.Max(16, _pollMs)));

            while (!ct.IsCancellationRequested)
            {
                try
                {
                    if (!await timer.WaitForNextTickAsync(ct))
                        break;

                    if (!_autoPoll)
                        continue;

                    var snap = await Api.GetSnapshot(ct);
                    var status = await Api.RunStatus(ct);

                    await InvokeAsync(() =>
                    {
                        _snapshot = snap;
                        _runStatus = status;
                        _stepIndex = snap.StepIndex;
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch
                {
                    // swallow polling errors; Api.LastError will show on manual Refresh
                }
            }
        }, ct);
    }

    public async ValueTask DisposeAsync()
    {
        _pollCts?.Cancel();

        if (_pollTask is not null)
        {
            try { await _pollTask; } catch { }
        }

        _pollCts?.Dispose();
    }
}

<style>
    .page {
        padding: 1rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .h1 {
        font-size: 1.6rem;
        font-weight: 700;
    }

    .sub {
        opacity: 0.75;
    }

    .status {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }
    @@media (max-width: 1100px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }

    .card {
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 14px;
        padding: 0.85rem;
        background: rgba(0,0,0,0.22);
    }

    .card-h {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 0.6rem;
    }

    .h-title {
        font-weight: 650;
    }

    .h-sub {
        opacity: 0.75;
        font-size: 0.92rem;
    }

    .pill {
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.18);
        font-size: 0.85rem;
    }

    .mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    .small {
        font-size: 0.86rem;
    }

    .err {
        color: #ffb3b3;
        font-weight: 600;
    }

    .muted {
        opacity: 0.70;
    }

    .form {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 0.5rem 0.75rem;
        align-items: center;
    }

    .lbl {
        opacity: 0.85;
    }

    .input {
        width: 100%;
        padding: 0.35rem 0.5rem;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,0.18);
        background: rgba(0,0,0,0.25);
        color: inherit;
    }

    .row {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .actions {
        margin-top: 0.75rem;
    }

    .btn {
        padding: 0.45rem 0.8rem;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.18);
        background: rgba(255,255,255,0.06);
        color: inherit;
        cursor: pointer;
    }

        .btn:hover {
            background: rgba(255,255,255,0.10);
        }

    .spacer {
        flex: 1;
    }

    .chk {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        padding: 0.25rem 0.4rem;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,0.10);
    }
</style>

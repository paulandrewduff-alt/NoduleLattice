﻿
@page "/"

@using NoduleLattice.Blazor.Components.Controls

<h1>Sanity View</h1>

@if (!string.IsNullOrWhiteSpace(_apiStatus))
{
    <div class="card" style="margin-bottom:1rem;">
        <div class="mono">@_apiStatus</div>
        @if (!string.IsNullOrWhiteSpace(_apiError))
        {
            <div class="muted" style="margin-top:0.35rem;">@_apiError</div>
        }
    </div>
}

<style>
    .layout {
        display: grid;
        grid-template-columns: 1.35fr 0.65fr;
        gap: 1rem;
        align-items: start;
    }

        .layout.dock-collapsed {
            grid-template-columns: 1fr 52px;
        }

    @@media (max-width: 1100px) {
        .layout, .layout.dock-collapsed {
            grid-template-columns: 1fr;
        }
    }

    .compact-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.75rem;
    }

    .inline-warn {
        border: 1px solid #2a2a2a;
        border-radius: 12px;
        padding: 0.5rem 0.6rem;
        margin: 0.5rem 0 0.25rem 0;
        opacity: 0.9;
    }
</style>

<div class="layout @(_dockCollapsed ? "dock-collapsed" : "")">

    <!-- LEFT: Big 3D view -->
    <section class="card">
        <header class="card-h">
            <div>
                <div class="h-title">3D Network</div>
                <div class="h-sub">Snapshot-only rendering • Orbit mouse controls</div>
            </div>
            <div class="pill">Step: @_stepIndex</div>
        </header>

        <Network3D Snapshot="_snapshot" HeightPx="680" />

        <div class="compact-actions">
            <button class="btn" @onclick="Refresh">Refresh</button>
            <button class="btn" @onclick="() => Step(1)">Step 1</button>
            <button class="btn" @onclick="() => Step(16)">Step 16</button>
            <button class="btn" @onclick="() => Step(128)">Step 128</button>

            <div class="spacer"></div>

            <button class="btn" @onclick="SleepReplay">Sleep (gated)</button>
        </div>
    </section>

    <!-- RIGHT: Collapsible ControlDock -->
    <ControlDock Title="Controls"
                 Subtitle="Tabbed panels • collapse to free 3D space"
                 ActiveBadge="@_dockBadge"
                 @bind-Collapsed="_dockCollapsed"
                 Thalamus="@ThalamusPanel"
                 Modulators="@ModulatorsPanel"
                 Stimulus="@StimulusPanel"
                 Hippocampus="@HippocampusPanel"
                 Injection="@InjectionPanel"
                 Archive="@ArchivePanel" />

</div>

@code {
    [Inject] private LatticeApiClient Api { get; set; } = default!;

    private long _stepIndex;
    private LatticeSnapshotDto? _snapshot;

    private UiModulators _mods = new();
    private UiInject _inject = new() { NodeId = 1, Exc = 0.25f, Inh = 0f };

    // Thalamus gate controls
    private float _gVision = 1.0f;
    private float _gAudio = 1.0f;
    private float _gBody = 1.0f;
    private float _gInternal = 0.35f;

    // Stimulus controls
    private int _stimGroup = 0;
    private float _stimRateHz = 8f;
    private float _stimStrength = 0.25f;
    private int _stimSteps = 32;

    // Hippocampus controls
    private bool _hipCaptureEnabled = true;
    private float _hipSalThr = 0.60f;
    private float _hipAltThr = 0.40f;
    private int _hipTopK = 18;
    private int _hipMax = 256;
    private float _hipDecay = 0.0015f;
    private float _hipMin = 0.06f;

    private int _hipReplayCount = 8;
    private float _hipReplayGain = 1.0f;
    private int _hipReplaySteps = 10;

    private HippocampusEpisodeListDto? _hipList;
    private int _hipEpisodesCount;
    private string _hipError = string.Empty;

    // UI: episode inspection
    private long? _hipSelectedId;
    private int _hipInspectTopN = 12;
    private bool _hipSortByRecency = false;

    private string _archiveBase64 = string.Empty;

    private string _apiStatus = string.Empty;
    private string _apiError = string.Empty;

    private bool _dockCollapsed;
    private string _dockBadge => _dockCollapsed ? "" : "Controls";

    protected override async Task OnInitializedAsync()
    {
        await ApplyGates();
        await ApplyHippocampus();
        await Refresh();
        await RefreshHippocampus();
    }

    private async Task Refresh()
    {
        _apiStatus = "API BaseUrl: (see appsettings: LatticeApi:BaseUrl)";
        _apiError = string.Empty;

        _snapshot = await Api.GetSnapshot();

        if (_snapshot is null)
        {
            _apiStatus += " • Snapshot: (not resolved)";
            _apiError = Api.LastError ?? "Unknown error.";
            _stepIndex = 0;
            return;
        }

        _apiStatus += $" • Snapshot: {Api.LastResolvedSnapshotPath}";
        _stepIndex = _snapshot.StepIndex;
        StateHasChanged();
    }

    private async Task Step(int n)
    {
        await Api.Step(n);
        await Refresh();
        await RefreshHippocampus();
    }

    private async Task ApplyModulators()
    {
        await Api.SetModulators(_mods);
        await Refresh();
    }

    private async Task ZeroModulators()
    {
        _mods = new UiModulators();
        await ApplyModulators();
    }

    private async Task ApplyGates()
    {
        var req = new ThalamusGatesRequest
        {
            VisionGate = _gVision,
            AudioGate = _gAudio,
            BodyGate = _gBody,
            InternalGate = _gInternal
        };

        await Api.SetThalamusGates(req);
        await Refresh();
    }

    private void PresetFocusVision() { _gVision = 1.0f; _gAudio = 0.15f; _gBody = 0.25f; _gInternal = 0.30f; }
    private void PresetFocusAudio() { _gVision = 0.15f; _gAudio = 1.0f; _gBody = 0.25f; _gInternal = 0.30f; }
    private void PresetBodyAwareness() { _gVision = 0.25f; _gAudio = 0.25f; _gBody = 1.0f; _gInternal = 0.30f; }
    private void PresetIdle() { _gVision = 0.55f; _gAudio = 0.55f; _gBody = 0.55f; _gInternal = 0.35f; }
    private void PresetSleep() { _gVision = 0.05f; _gAudio = 0.05f; _gBody = 0.05f; _gInternal = 0.60f; }

    private async Task ApplyHippocampus()
    {
        var req = new HippocampusConfigRequest
        {
            CaptureEnabled = _hipCaptureEnabled,
            CaptureSalienceThreshold = _hipSalThr,
            CaptureAlertingThreshold = _hipAltThr,
            TopK = _hipTopK,
            MaxEpisodes = _hipMax,
            DecayPerStep = _hipDecay,
            MinStrength = _hipMin
        };

        await Api.SetHippocampusConfig(req);
        await RefreshHippocampus();
    }

    private async Task RefreshHippocampus()
    {
        _hipError = string.Empty;

        var list = await Api.GetHippocampusEpisodes();
        if (list is null)
        {
            _hipList = null;
            _hipEpisodesCount = 0;
            _hipError = Api.LastError ?? "Failed to load hippocampus episodes.";
            return;
        }

        _hipList = list;
        _hipEpisodesCount = _hipList.Episodes?.Count ?? 0;

        // Keep selection stable if possible
        if (_hipSelectedId.HasValue)
        {
            if (_hipList.Episodes.All(e => e.Id != _hipSelectedId.Value))
                _hipSelectedId = null;
        }
    }

    private async Task ReplayHippocampus()
    {
        var req = new HippocampusReplayRequest
        {
            Count = _hipReplayCount,
            Gain = _hipReplayGain,
            StepsPerEpisode = _hipReplaySteps
        };

        await Api.ReplayHippocampus(req);
        await Refresh();
        await RefreshHippocampus();
    }

    private HippocampusEpisodeDto? SelectedEpisode
        => _hipList?.Episodes?.FirstOrDefault(e => e.Id == _hipSelectedId);

    private IEnumerable<HippocampusEpisodeDto> OrderedEpisodes()
    {
        if (_hipList?.Episodes is null) return Array.Empty<HippocampusEpisodeDto>();

        if (_hipSortByRecency)
        {
            return _hipList.Episodes
                .OrderBy(e => (_hipList.CurrentStep - e.CapturedAtStep))
                .ThenByDescending(e => e.Strength);
        }

        return _hipList.Episodes
            .OrderByDescending(e => e.Strength)
            .ThenByDescending(e => e.CapturedAtStep);
    }

    private void SelectEpisode(long id)
        => _hipSelectedId = id;

    private async Task ReplaySelectedEpisode()
    {
        if (_hipSelectedId is null) return;

        await Api.ReplayHippocampusEpisode(_hipSelectedId.Value, new HippocampusReplayOneRequest
        {
            Gain = _hipReplayGain,
            Steps = _hipReplaySteps
        });

        await Refresh();
        await RefreshHippocampus();
    }

    private async Task ReplayStrongestEpisode()
    {
        if (_hipList is null || _hipList.Episodes.Count == 0) return;

        HippocampusEpisodeDto best;

        if (_hipSortByRecency)
        {
            best = _hipList.Episodes
                .OrderByDescending(e =>
                {
                    var age = (float)(_hipList.CurrentStep - e.CapturedAtStep);
                    if (age < 0) age = 0;
                    float rec = 1f / (1f + age);
                    return (e.Strength * 0.70f) + (rec * 0.30f);
                })
                .First();
        }
        else
        {
            best = _hipList.Episodes.OrderByDescending(e => e.Strength).First();
        }

        _hipSelectedId = best.Id;
        await ReplaySelectedEpisode();
    }

    private async Task ClearHippocampus()
    {
        await Api.ClearHippocampus();
        await RefreshHippocampus();
    }

    private async Task Inject()
    {
        await Api.Inject(_inject);
        await Refresh();
    }

    private async Task RunStimulus()
    {
        var req = new StimulusRequest
        {
            Group = _stimGroup,
            RateHz = _stimRateHz,
            Strength = _stimStrength,
            Steps = _stimSteps
        };

        await Api.Stimulus(req);
        await Refresh();
        await RefreshHippocampus();
    }

    private async Task SleepReplay()
    {
        await Api.SleepReplay();
        await Refresh();
        await RefreshHippocampus();
    }

    private async Task SaveArchive()
    {
        var dto = await Api.GetArchive();
        _archiveBase64 = dto.Base64;
    }

    private async Task LoadArchive()
    {
        if (string.IsNullOrWhiteSpace(_archiveBase64)) return;
        await Api.LoadArchive(new ArchiveDto { Base64 = _archiveBase64.Trim() });
        await Refresh();
        await RefreshHippocampus();
    }

    private void ClearArchiveText() => _archiveBase64 = string.Empty;

    // ------------------------------
    // Panels (passed into ControlDock)
    // ------------------------------

    private RenderFragment ThalamusPanel => @<div>
        <div class="h-sub" style="margin-bottom:0.6rem;">TRN-like gating • routing: Vision→V1, Audio→A1, Body→S1, Internal→Core</div>
        <div class="form">
            @GateSlider("Vision Gate", nameof(_gVision))
            @GateSlider("Audio Gate", nameof(_gAudio))
            @GateSlider("Body Gate", nameof(_gBody))
            @GateSlider("Internal Gate", nameof(_gInternal))

            <div class="row" style="margin-top:0.5rem;">
                <button class="btn" @onclick="ApplyGates">Apply</button>
                <button class="btn" @onclick="PresetFocusVision">Focus Vision</button>
                <button class="btn" @onclick="PresetFocusAudio">Focus Audio</button>
            </div>

            <div class="row" style="margin-top:0.5rem;">
                <button class="btn" @onclick="PresetBodyAwareness">Body</button>
                <button class="btn" @onclick="PresetIdle">Idle</button>
                <button class="btn" @onclick="PresetSleep">Sleep</button>
            </div>
        </div>
    </div>;

    private RenderFragment ModulatorsPanel => @<div>
        <div class="h-sub" style="margin-bottom:0.6rem;">Explicit control only • biases effective gating and dynamics</div>
        <div class="form">
            @ModSlider("Reward", nameof(UiModulators.Reward))
            @ModSlider("Salience", nameof(UiModulators.Salience))
            @ModSlider("Stability", nameof(UiModulators.Stability))
            @ModSlider("Alerting", nameof(UiModulators.Alerting))
            @ModSlider("Curiosity", nameof(UiModulators.Curiosity))
            @ModSlider("Goal", nameof(UiModulators.Goal))

            <div class="row" style="margin-top:0.5rem;">
                <button class="btn" @onclick="ApplyModulators">Apply</button>
                <button class="btn" @onclick="ZeroModulators">Zero</button>
            </div>
        </div>
    </div>;

    private RenderFragment StimulusPanel => @<div>
        <div class="h-sub" style="margin-bottom:0.6rem;">Group: 0=Vision, 1=Audio, 2=Body, 3=Internal • passes through thalamus gate</div>
        <div class="form">
            <label>Group</label>
            <select class="input" @bind="_stimGroup">
                <option value="0">Vision</option>
                <option value="1">Audio</option>
                <option value="2">Body</option>
                <option value="3">Internal</option>
            </select>

            <label>Rate (Hz)</label>
            <input class="input" type="number" step="1" @bind="_stimRateHz" />

            <label>Strength</label>
            <input class="input" type="number" step="0.01" @bind="_stimStrength" />

            <label>Steps</label>
            <input class="input" type="number" step="1" @bind="_stimSteps" />

            <div class="row" style="margin-top:0.5rem;">
                <button class="btn" @onclick="RunStimulus">Stimulate</button>
                <div class="spacer"></div>
                <button class="btn" @onclick="Refresh">Refresh</button>
            </div>
        </div>
    </div>;

    private RenderFragment HippocampusPanel => @<div>
        <style>
            .mem-grid { display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem; }
            .mem-list { border:1px solid #2a2a2a; border-radius:12px; overflow:hidden; }
            .mem-row { display:flex; gap:0.6rem; justify-content:space-between; padding:0.35rem 0.55rem; border-bottom:1px solid #2a2a2a; cursor:pointer; }
            .mem-row:hover { filter: brightness(1.05); }
            .mem-row.sel { background:#1e1e1e; box-shadow: 0 0 0 1px rgba(255,255,255,0.05) inset; }
            .mem-kv { display:grid; grid-template-columns: 1fr 1fr; gap:0.4rem; }
            .mem-kv .pill { justify-self:start; }
            .mem-nodes { max-height: 220px; overflow:auto; border:1px solid #2a2a2a; border-radius:12px; padding:0.5rem; }
            .mem-mini { opacity:0.85; }
            @@media (max-width: 1100px) { .mem-grid { grid-template-columns: 1fr; } }
        </style>

        <div class="h-sub" style="margin-bottom:0.6rem;">Episodic capture (decay) + replay bursts into Internal channel • select an episode to inspect</div>

        @if (!string.IsNullOrWhiteSpace(_hipError))
        {
            <div class="inline-warn mono">Hippocampus: @_hipError</div>
        }

        <div class="form">
            <label>Capture Enabled</label>
            <input type="checkbox" @bind="_hipCaptureEnabled" />

            <label>Capture Salience Threshold</label>
            <input class="input" type="number" step="0.01" @bind="_hipSalThr" />

            <label>Capture Alerting Threshold</label>
            <input class="input" type="number" step="0.01" @bind="_hipAltThr" />

            <label>Top-K</label>
            <input class="input" type="number" step="1" @bind="_hipTopK" />

            <label>Max Episodes</label>
            <input class="input" type="number" step="1" @bind="_hipMax" />

            <label>Decay Per Step</label>
            <input class="input" type="number" step="0.0001" @bind="_hipDecay" />

            <label>Min Strength</label>
            <input class="input" type="number" step="0.01" @bind="_hipMin" />

            <div class="row" style="margin-top:0.5rem;">
                <button class="btn" @onclick="ApplyHippocampus">Apply</button>
                <button class="btn" @onclick="RefreshHippocampus">Refresh List</button>
                <div class="spacer"></div>
                <button class="btn" @onclick="ClearHippocampus">Clear</button>
            </div>

            <hr />

            <label>Replay Count (batch)</label>
            <input class="input" type="number" step="1" min="1" max="128" @bind="_hipReplayCount" />

            <label>Replay Gain</label>
            <input class="input" type="number" step="0.1" @bind="_hipReplayGain" />

            <label>Steps After Replay</label>
            <input class="input" type="number" step="1" @bind="_hipReplaySteps" />

            <div class="row" style="margin-top:0.5rem;">
                <button class="btn" title="Composite strength+recency" @onclick="ReplayHippocampus">Replay Batch</button>
                <button class="btn" @onclick="ReplayStrongestEpisode">Replay Strongest</button>
                <button class="btn" disabled="@(_hipSelectedId is null)" @onclick="ReplaySelectedEpisode">Replay Selected</button>
                <div class="spacer"></div>
                <span class="pill">Episodes: @_hipEpisodesCount</span>
            </div>

            <div class="row" style="margin-top:0.5rem;">
                <label style="margin:0; display:flex; align-items:center; gap:0.5rem;">
                    <input type="checkbox" @bind="_hipSortByRecency" />
                    <span class="muted">Sort by recency</span>
                </label>
                <div class="spacer"></div>
                <label style="margin:0; display:flex; align-items:center; gap:0.5rem;">
                    <span class="muted">Inspect Top</span>
                    <input class="input" style="width:90px;" type="number" step="1" min="1" max="64" @bind="_hipInspectTopN" />
                </label>
            </div>

            <hr />

            @if (_hipList is not null)
            {
                <div class="mono" style="margin-bottom:0.5rem;">CurrentStep: @_hipList.CurrentStep</div>

                <div class="mem-grid">
                    <div>
                        <div class="mem-list" style="max-height:320px; overflow:auto;">
                            @foreach (var ep in OrderedEpisodes().Take(96))
                            {
                                var age = _hipList.CurrentStep - ep.CapturedAtStep;
                                var sel = _hipSelectedId == ep.Id;
                                <div class="mem-row mono @(sel ? "sel" : "")" @onclick="() => SelectEpisode(ep.Id)">
                                    <span>Ep @ep.Id</span>
                                    <span class="mem-mini">age @age</span>
                                    <span class="mem-mini">str @ep.Strength.ToString("0.00")</span>
                                    <span class="mem-mini">k @ep.NodeIds.Length</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div>
                        @if (SelectedEpisode is null)
                        {
                            <div class="card" style="padding:0.75rem;">
                                <div class="h-title">Inspect</div>
                                <div class="muted">Select an episode on the left.</div>
                            </div>
                        }
                        else
                        {
                            var ep = SelectedEpisode;
                            var age = _hipList.CurrentStep - ep!.CapturedAtStep;
                            <div class="card" style="padding:0.75rem;">
                                <div class="row" style="align-items:center;">
                                    <div>
                                        <div class="h-title">Episode @ep.Id</div>
                                        <div class="h-sub">age @age • strength @ep.Strength.ToString("0.00") • k @ep.NodeIds.Length</div>
                                    </div>
                                    <div class="spacer"></div>
                                    <div class="pill">Captured @ep.CapturedAtStep</div>
                                </div>

                                <div style="margin-top:0.6rem;" class="mem-kv">
                                    <div>
                                        <div class="muted" style="margin-bottom:0.25rem;">Context Modulators</div>
                                        <div class="mono">
                                            R @ep.ContextMods.Reward.ToString("0.00") • S @ep.ContextMods.Salience.ToString("0.00") • St @ep.ContextMods.Stability.ToString("0.00")<br />
                                            A @ep.ContextMods.Alerting.ToString("0.00") • C @ep.ContextMods.Curiosity.ToString("0.00") • G @ep.ContextMods.Goal.ToString("0.00")
                                        </div>
                                    </div>
                                    <div>
                                        <div class="muted" style="margin-bottom:0.25rem;">Context Thalamus</div>
                                        <div class="mono">
                                            V @ep.ContextThalamus.VisionGate.ToString("0.00") • Au @ep.ContextThalamus.AudioGate.ToString("0.00") • B @ep.ContextThalamus.BodyGate.ToString("0.00") • In @ep.ContextThalamus.InternalGate.ToString("0.00")
                                        </div>
                                    </div>
                                </div>

                                <div class="muted" style="margin-top:0.75rem; margin-bottom:0.35rem;">Top nodes (by |rate| at capture)</div>
                                <div class="mem-nodes mono">
                                    @{
                                        int n = Math.Min(Math.Min(ep.NodeIds.Length, ep.Values.Length), Math.Clamp(_hipInspectTopN, 1, 64));
                                        for (int i = 0; i < n; i++)
                                        {
                                            <div style="padding:0.15rem 0; border-bottom:1px solid #222;">
                                                <span style="display:inline-block; width:70px;">node @ep.NodeIds[i]</span>
                                                <span class="mem-mini">|r| @ep.Values[i].ToString("0.000")</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>;

    private RenderFragment InjectionPanel => @<div>
    <div class="h-sub" style="margin-bottom:0.6rem;">External input only (exc/inh) • explicit action</div>
    <div class="form">
        <label>Node Id</label>
        <input class="input" type="number" @bind="_inject.NodeId" />

        <label>Exc</label>
        <input class="input" type="number" step="0.01" @bind="_inject.Exc" />

        <label>Inh</label>
        <input class="input" type="number" step="0.01" @bind="_inject.Inh" />

        <div class="row" style="margin-top:0.5rem;">
            <button class="btn" @onclick="Inject">Inject</button>
            <div class="spacer"></div>
            <button class="btn" @onclick="Refresh">Refresh</button>
        </div>
    </div>
</div>;

private RenderFragment ArchivePanel => @<div>
    <div class="h-sub" style="margin-bottom:0.6rem;">Save/Load engine state (includes hippocampus episodes)</div>
    <div class="form">
        <div class="row">
            <button class="btn" @onclick="SaveArchive">Save</button>
            <button class="btn" @onclick="LoadArchive">Load</button>
            <div class="spacer"></div>
            <button class="btn" @onclick="ClearArchiveText">Clear</button>
        </div>

        <label>Base64 Archive</label>
        <textarea class="textarea mono archive" rows="14" spellcheck="false" wrap="off" @bind="_archiveBase64"></textarea>
    </div>
</div>;

// ------------------------------
// Shared slider fragments
// ------------------------------

private RenderFragment GateSlider(string title, string field) => builder =>
{
    int seq = 0;
    builder.OpenElement(seq++, "div");
    builder.AddAttribute(seq++, "class", "slider");

    builder.OpenElement(seq++, "div");
    builder.AddAttribute(seq++, "class", "slider-h");

    builder.OpenElement(seq++, "div");
    builder.AddContent(seq++, title);
    builder.CloseElement();

    builder.OpenElement(seq++, "div");
    builder.AddAttribute(seq++, "class", "mono");
    builder.AddContent(seq++, $"{GetGate(field):0.00}");
    builder.CloseElement();

    builder.CloseElement();

    builder.OpenElement(seq++, "input");
    builder.AddAttribute(seq++, "class", "range");
    builder.AddAttribute(seq++, "type", "range");
    builder.AddAttribute(seq++, "min", "0");
    builder.AddAttribute(seq++, "max", "1");
    builder.AddAttribute(seq++, "step", "0.01");
    builder.AddAttribute(seq++, "value", BindConverter.FormatValue(GetGate(field)));
    builder.AddAttribute(seq++, "oninput",
        EventCallback.Factory.CreateBinder<string>(this, v => SetGate(field, v), BindConverter.FormatValue(GetGate(field))));
    builder.CloseElement();

    builder.CloseElement();
};

private float GetGate(string field) => field switch
{
    nameof(_gVision) => _gVision,
    nameof(_gAudio) => _gAudio,
    nameof(_gBody) => _gBody,
    nameof(_gInternal) => _gInternal,
    _ => 0f
};

private void SetGate(string field, string raw)
{
    if (!float.TryParse(raw, out var v)) return;
    v = Math.Clamp(v, 0f, 1f);

    switch (field)
    {
        case nameof(_gVision): _gVision = v; break;
        case nameof(_gAudio): _gAudio = v; break;
        case nameof(_gBody): _gBody = v; break;
        case nameof(_gInternal): _gInternal = v; break;
    }
}

private RenderFragment ModSlider(string title, string prop) => builder =>
{
    int seq = 0;

    builder.OpenElement(seq++, "div");
    builder.AddAttribute(seq++, "class", "slider");

    builder.OpenElement(seq++, "div");
    builder.AddAttribute(seq++, "class", "slider-h");

    builder.OpenElement(seq++, "div");
    builder.AddContent(seq++, title);
    builder.CloseElement();

    builder.OpenElement(seq++, "div");
    builder.AddAttribute(seq++, "class", "mono");
    builder.AddContent(seq++, $"{GetMod(prop):0.00}");
    builder.CloseElement();

    builder.CloseElement();

    builder.OpenElement(seq++, "input");
    builder.AddAttribute(seq++, "class", "range");
    builder.AddAttribute(seq++, "type", "range");
    builder.AddAttribute(seq++, "min", "0");
    builder.AddAttribute(seq++, "max", "1");
    builder.AddAttribute(seq++, "step", "0.01");
    builder.AddAttribute(seq++, "value", BindConverter.FormatValue(GetMod(prop)));
    builder.AddAttribute(seq++, "oninput",
        EventCallback.Factory.CreateBinder<string>(this, v => SetMod(prop, v), BindConverter.FormatValue(GetMod(prop))));
    builder.CloseElement();

    builder.CloseElement();
};

private float GetMod(string prop) => prop switch
{
    nameof(UiModulators.Reward) => _mods.Reward,
    nameof(UiModulators.Salience) => _mods.Salience,
    nameof(UiModulators.Stability) => _mods.Stability,
    nameof(UiModulators.Alerting) => _mods.Alerting,
    nameof(UiModulators.Curiosity) => _mods.Curiosity,
    nameof(UiModulators.Goal) => _mods.Goal,
    _ => 0f
};

private void SetMod(string prop, string raw)
{
    if (!float.TryParse(raw, out var v)) return;
    v = Math.Clamp(v, 0f, 1f);

    switch (prop)
    {
        case nameof(UiModulators.Reward): _mods.Reward = v; break;
        case nameof(UiModulators.Salience): _mods.Salience = v; break;
        case nameof(UiModulators.Stability): _mods.Stability = v; break;
        case nameof(UiModulators.Alerting): _mods.Alerting = v; break;
        case nameof(UiModulators.Curiosity): _mods.Curiosity = v; break;
        case nameof(UiModulators.Goal): _mods.Goal = v; break;
    }
}
}

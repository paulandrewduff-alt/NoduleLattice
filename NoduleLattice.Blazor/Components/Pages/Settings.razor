@page "/settings"

<h1>Settings</h1>

<div class="card">
    <header class="card-h">
        <div>
            <div class="h-title">API Base URL</div>
            <div class="h-sub">Configured via appsettings / environment</div>
        </div>
    </header>

    <p style="padding:0.25rem 0;">
        Set <span class="mono">LatticeApi:BaseUrl</span> in configuration.
    </p>

    <p class="muted">
        Example: <span class="mono">http://localhost:5000/</span>
    </p>
</div>